# Postgres connection string (local Postgres or Supabase: Settings → Database → Connection string)
DATABASE_URL=postgres://user@127.0.0.1:5432/preleague
# Bearer token for /api/cron/* (required in production)
CRON_SECRET=
# Secret for /admin and /api/admin (required in production)
ADMIN_SECRET=
# Run the price collector + settlement loop inside the Next server (local dev / single server).
# Leave unset on Vercel: page views + an external pinger on /api/cron/tick drive the jobs.
RUN_JOBS_IN_PROCESS=1
# Optional: scheduler interval in ms (default 60000)
JOB_INTERVAL_MS=
# Solana RPC for the wallet adapter (defaults to public mainnet-beta)
NEXT_PUBLIC_SOLANA_RPC_URL=
# Devnet prize payouts (written by `npm run prize:setup`)
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
PRIZE_AUTHORITY_SECRET=
PRIZE_MINT=
